{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "emdash-commerce-starter",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d661cf6b58964841a7d455c5b7fcd5d6"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "emdash-commerce-starter"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "emdash-commerce-media"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
