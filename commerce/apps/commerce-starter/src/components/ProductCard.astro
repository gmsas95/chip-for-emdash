---
import { formatMinorAmount, imageUrl, type CatalogProduct } from "../lib/commerce";
interface Props { product: CatalogProduct; }
const { product } = Astro.props;
const image = product.images[0];
const price = product.priceMinor ?? product.variants[0]?.priceMinor ?? 0;
---
<a class="product-card" href={`/shop/${product.slug}`}>
  <img src={imageUrl(image?.url)} alt={image?.alt || product.name} loading="lazy" />
  <div class="product-card-body">
    <h3>{product.name}</h3>
    <p>{formatMinorAmount(price, product.currency)}</p>
  </div>
</a>
