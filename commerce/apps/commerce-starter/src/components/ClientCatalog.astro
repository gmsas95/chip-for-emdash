---
interface Props { id: string; limit?: number; }
const { id, limit = 50 } = Astro.props;
---
<div id={id} data-catalog-grid data-limit={limit} class="product-grid" aria-live="polite"><p class="notice">Loading the collection...</p></div>
<script is:inline>
  (() => {
    const root = document.querySelector("[data-catalog-grid]");
    if (!root) return;
    const format = (minor, currency) => new Intl.NumberFormat("en-MY", { style: "currency", currency }).format((Number.isSafeInteger(minor) && minor >= 0 ? minor : 0) / 100);
    const image = (url) => url || "/commerce-placeholder.svg";
    const render = (items) => {
      root.replaceChildren();
      if (!items.length) { const empty = document.createElement("p"); empty.className = "empty-state"; empty.textContent = "No products are published yet."; root.append(empty); return; }
      for (const product of items.slice(0, Number(root.getAttribute("data-limit") || 50))) {
        const link = document.createElement("a"); link.className = "product-card"; link.href = `/shop/${encodeURIComponent(product.data.slug)}`;
        const productImage = document.createElement("img"); productImage.src = image(product.data.images?.[0]?.url); productImage.alt = product.data.images?.[0]?.alt || product.data.name; productImage.loading = "lazy";
        const body = document.createElement("div"); body.className = "product-card-body";
        const title = document.createElement("h3"); title.textContent = product.data.name;
        const amount = document.createElement("p"); const firstVariant = product.data.hasVariants ? product.data.variants?.[0] : undefined; amount.textContent = format(firstVariant?.priceMinor ?? product.data.priceMinor ?? 0, firstVariant?.currency || product.data.currency);
        body.append(title, amount); link.append(productImage, body); root.append(link);
      }
    };
    fetch("/_emdash/api/plugins/emdash-commerce/catalog", { credentials: "same-origin", headers: { "X-EmDash-Request": "1" } })
      .then((response) => response.json().then((body) => ({ response, body })))
      .then(({ response, body }) => { if (!response.ok || body.success !== true) throw new Error(body.error?.message || "Catalog unavailable"); render(body.data?.items || []); })
      .catch(() => { root.replaceChildren(); const error = document.createElement("p"); error.className = "error-state"; error.textContent = "We couldn't load the collection. Please try again."; root.append(error); });
  })();
</script>
