---
import { imageUrl, type CatalogProduct } from "../lib/commerce";
interface Props { product: CatalogProduct; }
const { product } = Astro.props;
const images = product.images.length > 0 ? product.images : [{ mediaId: "placeholder", url: "/commerce-placeholder.svg", alt: product.name }];
---
<div class="product-gallery">
  <img id="product-main-image" src={imageUrl(images[0].url)} alt={images[0].alt || product.name} />
  {images.length > 1 && <div class="product-thumbnails" aria-label="Product images">
    {images.map((image, index) => <button type="button" data-product-image={image.url} data-product-alt={image.alt || product.name} aria-label={`Show image ${index + 1}`}><img src={imageUrl(image.url)} alt="" loading="lazy" /></button>)}
  </div>}
</div>
<script is:inline>
  document.querySelectorAll("[data-product-image]").forEach((button) => {
    button.addEventListener("click", () => {
      const image = document.querySelector("#product-main-image");
      if (image instanceof HTMLImageElement) {
        image.src = button.getAttribute("data-product-image") || "/commerce-placeholder.svg";
        image.alt = button.getAttribute("data-product-alt") || "Product image";
      }
    });
  });
</script>
