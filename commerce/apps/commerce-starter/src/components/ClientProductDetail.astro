---
interface Props { slug: string; }
const { slug } = Astro.props;
---
<div id="product-detail-app" class="product-detail-grid" data-product-slug={slug}><p class="notice">Loading product...</p></div>
<script is:inline>
  (() => {
    const root = document.querySelector("#product-detail-app");
    if (!root) return;
    const slug = root.getAttribute("data-product-slug");
    const format = (minor, currency) => new Intl.NumberFormat("en-MY", { style: "currency", currency }).format((Number.isSafeInteger(minor) && minor >= 0 ? minor : 0) / 100);
    const showError = (message) => { root.replaceChildren(); const error = document.createElement("p"); error.className = "error-state"; error.textContent = message; root.append(error); };
    fetch("/_emdash/api/plugins/emdash-commerce/catalog", { credentials: "same-origin", headers: { "X-EmDash-Request": "1" } })
      .then((response) => response.json().then((body) => ({ response, body })))
      .then(({ response, body }) => { if (!response.ok || body.success !== true) throw new Error(body.error?.message || "Catalog unavailable"); return body.data?.items?.find((item) => item.data.slug === slug); })
      .then((item) => {
        if (!item) { showError("Product not found."); return; }
        const product = item.data;
        const gallery = document.createElement("div"); gallery.className = "product-gallery";
        const mainImage = document.createElement("img"); mainImage.id = "product-main-image"; mainImage.src = product.images?.[0]?.url || "/commerce-placeholder.svg"; mainImage.alt = product.images?.[0]?.alt || product.name; gallery.append(mainImage);
        const details = document.createElement("div");
        const eyebrow = document.createElement("p"); eyebrow.className = "eyebrow"; eyebrow.textContent = product.sku || "Collection piece";
        const title = document.createElement("h1"); title.textContent = product.name;
        const description = document.createElement("p"); description.className = "lede"; description.textContent = product.description || "";
        const price = document.createElement("p"); price.className = "product-price";
        let selectedVariant;
        if (product.hasVariants && product.variants?.length) {
          const label = document.createElement("label"); label.textContent = "Choose an option";
          const select = document.createElement("select"); select.id = "product-variant";
          for (const variant of product.variants) { const option = document.createElement("option"); option.value = variant.id; option.textContent = `${variant.name} — ${format(variant.priceMinor, variant.currency)}`; select.append(option); }
          selectedVariant = () => product.variants.find((variant) => variant.id === select.value) || product.variants[0];
          select.addEventListener("change", () => { const variant = selectedVariant(); price.textContent = format(variant.priceMinor, variant.currency); });
          label.append(select); details.append(label);
          selectedVariant = (() => { const first = product.variants[0]; return () => product.variants.find((variant) => variant.id === select.value) || first; })();
        }
        const initialVariant = product.hasVariants ? product.variants?.[0] : undefined; price.textContent = format(initialVariant?.priceMinor ?? product.priceMinor ?? 0, initialVariant?.currency || product.currency);
        const quantityLabel = document.createElement("label"); quantityLabel.textContent = "Quantity"; const quantity = document.createElement("input"); quantity.type = "number"; quantity.min = "1"; quantity.max = "99"; quantity.value = "1"; quantityLabel.append(quantity);
        const add = document.createElement("button"); add.type = "button"; add.textContent = "Add to cart"; const feedback = document.createElement("p"); feedback.setAttribute("role", "status");
        add.addEventListener("click", () => { const variant = selectedVariant ? selectedVariant() : undefined; const lines = JSON.parse(window.localStorage.getItem("commerce-cart-lines") || "[]"); lines.push({ productId: item.id, ...(variant ? { variantId: variant.id } : {}), quantity: Math.max(1, Math.min(99, Number(quantity.value) || 1)) }); window.localStorage.setItem("commerce-cart-lines", JSON.stringify(lines)); feedback.textContent = "Added to cart."; });
        details.prepend(eyebrow, title, description, price); details.append(quantityLabel, add, feedback); root.replaceChildren(gallery, details);
      })
      .catch((error) => showError(error instanceof Error ? error.message : "Catalog unavailable"));
  })();
</script>
