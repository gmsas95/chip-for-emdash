---
import Base from "../../layouts/Base.astro";
const orderId = Astro.params.id ?? "";
---
<Base title="Order status" description="View your order status.">
  <div class="page-wrap section">
    <p class="eyebrow">Order status</p>
    <h1>Order {orderId}</h1>
    <div id="order-state" class="notice" role="status">Loading order status...</div>
    <script is:inline define:vars={{ orderId }}>
      (() => {
        const root = document.querySelector("#order-state");
        if (!root) return;
        const token = window.localStorage.getItem("commerce-order-access-token");
        if (!token) { root.textContent = "Open this page from the same browser used at checkout, or contact support with your order ID."; return; }
        fetch("/_emdash/api/plugins/emdash-commerce/order", { method: "POST", credentials: "same-origin", headers: { "content-type": "application/json", "X-EmDash-Request": "1" }, body: JSON.stringify({ orderId, orderAccessToken: token }) })
          .then(async (response) => { const envelope = await response.json(); if (!response.ok || envelope.success !== true) throw new Error(envelope.error?.message || "Order not found"); return envelope.data; })
          .then((order) => { root.textContent = `Status: ${order.status || "created"} · Total: ${order.total?.amountMinor ?? order.totalMinor} ${order.currency}`; })
          .catch((error) => { root.textContent = error instanceof Error ? error.message : "Order not found"; });
      })();
    </script>
  </div>
</Base>
