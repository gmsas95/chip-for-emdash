---
import { getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import ClientCatalog from "../components/ClientCatalog.astro";
import CmsPageContent from "../components/CmsPageContent.astro";
import { loadCmsPage } from "../lib/cms";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { page: homePage, cacheHint } = await loadCmsPage("home");
Astro.cache.set(cacheHint);
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
const title = homePage?.data.title ?? siteTitle;
---
<Base title={title} description={siteTagline} content={homePage ? { collection: "pages", id: homePage.data.id ?? homePage.id, slug: homePage.id } : undefined}>
  <section class="cms-hero">
    {homePage ? <CmsPageContent page={homePage} /> : <div class="page-wrap section"><h1>Homepage content is not published.</h1><p>Publish the <code>home</code> page from EmDash Admin to control this storefront.</p><a class="button" href="/_emdash/admin/content/pages/new">Create homepage content</a></div>}
  </section>
  <section class="section" aria-labelledby="featured-heading">
    <div class="section-heading">
      <div><h2 id="featured-heading">Published products</h2><p>Live from Commerce Core.</p></div>
      <a class="button secondary" href="/shop">View all</a>
    </div>
    <ClientCatalog id="featured-products" limit={4} />
  </section>
</Base>
