---
import Base from "../../layouts/Base.astro";
const resultStatus = Astro.url.searchParams.get("status")?.toLowerCase() ?? "pending";
const title = resultStatus === "success" || resultStatus === "paid" ? "Payment received" : resultStatus === "cancel" || resultStatus === "cancelled" ? "Payment cancelled" : resultStatus === "failure" || resultStatus === "failed" ? "Payment needs attention" : "Payment status";
const copy = resultStatus === "success" || resultStatus === "paid" ? "Your payment was confirmed. We are preparing the order record." : resultStatus === "cancel" || resultStatus === "cancelled" ? "No payment was completed. Your cart is still available." : resultStatus === "failure" || resultStatus === "failed" ? "The payment did not complete. You can return to checkout and try again." : "We are checking the payment status. Refresh this page if you just returned from CHIP.";
---
<Base title={title} description={copy}>
  <div class="page-wrap section">
    <p class="eyebrow">Checkout result</p>
    <h1>{title}</h1>
    <p class="lede">{copy}</p>
    <p><a class="button" href={resultStatus === "success" || resultStatus === "paid" ? "/" : "/checkout"}>{resultStatus === "success" || resultStatus === "paid" ? "Continue shopping" : "Return to checkout"}</a></p>
    <p><a id="order-link" href="/orders/">View your order if you have the order ID.</a></p>
    <script is:inline define:vars={{ resultStatus }}>
      (() => {
        const orderId = window.localStorage.getItem("commerce-order-id");
        const orderLink = document.querySelector("#order-link");
        if (orderId && orderLink instanceof HTMLAnchorElement) orderLink.href = `/orders/${encodeURIComponent(orderId)}`;
        if ((resultStatus === "success" || resultStatus === "paid") && orderId) window.localStorage.removeItem("commerce-cart-lines");
      })();
    </script>
  </div>
</Base>
