{
  "name": "@emdash-commerce/workspace",
  "version": "0.1.0",
  "description": "Provider-neutral Commerce Core and Contracts for EmDash.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gmsas95/emdash-commerce-core.git"
  },
  "bugs": {
    "url": "https://github.com/gmsas95/emdash-commerce-core/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "test": "vitest run",
    "build": "pnpm --filter @emdash-commerce/contracts build && pnpm --filter @emdash-commerce/core build",
    "lint": "tsc --noEmit -p tsconfig.base.json"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
